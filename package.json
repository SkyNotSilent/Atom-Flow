{
  "name": "atomflow",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "billing:setup:test-account": "tsx scripts/setup-paddle-sandbox.ts --local-account-only",
    "billing:setup:sandbox": "tsx scripts/setup-paddle-sandbox.ts",
    "billing:verify:sandbox": "tsx scripts/setup-paddle-sandbox.ts --verify-only",
    "billing:dev:sandbox": "node --env-file=.env --env-file=.env.billing.sandbox --import tsx server.ts",
    "billing:test:sandbox": "RUN_REAL_BILLING_TESTS=true node --env-file=.env --env-file=.env.billing.sandbox --import tsx --test --test-concurrency=1 tests/billing-sandbox.test.ts",
    "test:rss:soak": "node --expose-gc --import tsx --test --test-concurrency=1 tests/rss-memory-soak.test.ts tests/rss-parse-memory-soak.test.ts",
    "test:rss:cache": "node --import tsx --test --test-concurrency=1 tests/rss-cache.test.ts",
    "alert:test": "tsx scripts/send-test-alert.ts",
    "lint": "tsc --noEmit",
    "test:migrations": "node --import tsx --test --test-concurrency=1 tests/database-migrations.test.ts tests/database-migrations.integration.test.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/rss-runtime.test.ts tests/service-health-monitor.test.ts tests/security-hardening.test.ts tests/compliance-disclosures.test.ts tests/billing-config.test.ts tests/billing-access.test.ts tests/billing-runtime.test.ts tests/billing-contract.test.ts tests/billing-frontend.test.ts tests/alipay-subscription.test.ts tests/billing-sandbox-setup.test.ts tests/billing-sandbox.test.ts tests/reader-sanitization.test.ts tests/reading-article-race.test.ts tests/frontend-reliability.test.ts tests/logging.test.ts tests/rss-source-resilience.test.ts tests/avatar.test.ts tests/knowledge-deduplication.test.ts tests/agent-draft-export.test.ts tests/write-agent-intent.test.ts tests/write-agent-sse.test.ts tests/write-agent-api.test.ts tests/write-canvas-api.test.ts tests/write-canvas-ai-api.test.ts tests/write-canvas-ui.test.ts tests/canvas-document-validation.test.ts tests/canvas-create-article-requests.test.ts tests/canvas-project-target.test.ts tests/canvas-document-export.test.ts tests/canvas-agent-group-ui.test.ts tests/canvas-document-autosave.test.ts tests/write-focused-workspace.test.ts tests/podcast-preview.test.ts tests/podcast-playback-state.test.ts tests/podcast-interface.test.ts tests/podcast-page.test.ts tests/podcast-navigation.test.ts"
  },
