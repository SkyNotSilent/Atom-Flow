# APP_URL: Canonical public HTTPS URL. Set this in Railway Variables.
# Railway may also provide RAILWAY_PUBLIC_DOMAIN, but an explicit APP_URL is preferred.
APP_URL="https://your-domain.example"

# Required identity, policy and retention values for a public production instance.
DEPLOYMENT_OPERATOR_NAME="replace-with-legal-operator-name"
DEPLOYMENT_OPERATOR_ADDRESS="replace-with-operator-address"
SERVICE_CONTACT_EMAIL="replace-with-service-contact@example.invalid"
PRIVACY_CONTACT_EMAIL="replace-with-privacy-contact@example.invalid"
SECURITY_CONTACT_EMAIL="replace-with-security-contact@example.invalid"
# Required before enabling paid billing; may equal SERVICE_CONTACT_EMAIL.
REFUND_CONTACT_EMAIL="replace-with-refund-contact@example.invalid"
SERVICE_URL="https://your-domain.example"
DATA_HOSTING_REGION="replace-with-actual-data-hosting-region"
TERMS_EFFECTIVE_DATE="2026-07-13"
GOVERNING_LAW="replace-with-applicable-governing-law"
DISPUTE_FORUM="replace-with-court-or-dispute-forum"
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30
RIGHTS_REQUEST_RESPONSE_DAYS=30

# SESSION_SECRET: Secret key for session cookie signing; use at least 32 random characters in production.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Production origin and request controls.
ALLOWED_ORIGINS="https://your-domain.example"
VITE_TLDRAW_LICENSE_KEY="your-production-tldraw-license-key"

# Magic Writing Pro billing. Alipay uses one-time website payments that grant a
# fixed term; users renew manually and no automatic debit agreement is created.
BILLING_ENABLED=false
# Current checkout provider.
BILLING_PROVIDER=alipay
# Alipay website payment uses the production gateway. Private keys must
# remain server-only; multiline PEM values may be stored with literal \n separators.
ALIPAY_APP_ID=""
ALIPAY_SELLER_ID=""
ALIPAY_APP_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_KEY_TYPE=PKCS8
# Required when the app calls on behalf of a newly authorized merchant.
ALIPAY_APP_AUTH_TOKEN=""
ALIPAY_NOTIFY_URL="https://your-domain.example/api/billing/webhooks/alipay"
ALIPAY_RETURN_URL="https://your-domain.example/?view=write&billing_return=alipay"

# Legacy Paddle rollback configuration. Leave disabled/unset when BILLING_PROVIDER=alipay.
PADDLE_ENVIRONMENT=sandbox
# Public build-time mirror used only to select the matching Paddle.js environment.
VITE_PADDLE_ENVIRONMENT=sandbox
# Secret server-side credentials. Never expose these through VITE_* variables.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# Public client-side token used by Paddle.js. Sandbox tokens start with test_.
VITE_PADDLE_CLIENT_TOKEN=""
# Sandbox and Live must use separate product and price IDs.
PADDLE_MAGIC_WRITE_PRODUCT_ID=""
PADDLE_MAGIC_WRITE_MONTHLY_PRICE_ID=""
PADDLE_MAGIC_WRITE_YEARLY_PRICE_ID=""
# Optional comma-separated retired Price IDs that still grant existing subscribers access.
PADDLE_MAGIC_WRITE_LEGACY_PRICE_IDS=""
# Sandbox bootstrap only: a public HTTPS tunnel/staging URL for Paddle callbacks.
PADDLE_WEBHOOK_URL=""
# Opt-in isolated Sandbox integration tests only (never configure in public CI).
RUN_REAL_BILLING_TESTS=false
BILLING_TEST_BASE_URL="http://localhost:1000"
PADDLE_SANDBOX_SIMULATION_IDS=""
# Same-origin podcast media proxy safeguards (remote RSS audio remains SSRF-checked).
MEDIA_PROXY_RANGE_MB=8
MEDIA_PROXY_TIMEOUT_MS=20000
MEDIA_PROXY_USER_CONCURRENCY=2
MEDIA_PROXY_GLOBAL_CONCURRENCY=8
API_RATE_LIMIT=300
AUTH_LOGIN_RATE_LIMIT=10
AUTH_CODE_IP_RATE_LIMIT=5
AUTH_CODE_EMAIL_RATE_LIMIT=3
AUTH_VERIFY_RATE_LIMIT=10
AUTH_VERIFY_IP_RATE_LIMIT=30
PAID_OPERATION_RATE_LIMIT=20
PAID_OPERATION_DAILY_LIMIT=100
PAID_OUTPUT_TOKENS_DAILY_LIMIT=200000
PAID_OPERATION_CONCURRENCY=2
PAID_OPERATION_GLOBAL_CONCURRENCY=8
PAID_OPERATION_LEASE_MS=180000
AI_REQUEST_TIMEOUT_MS=120000
REMOTE_FETCH_RATE_LIMIT=30
REMOTE_RSS_MAX_MB=5
REMOTE_RSS_MAX_ITEMS=500
# Built-in RSS runtime: one non-overlapping cycle every 30 minutes, bounded to four sources at once.
RSS_REFRESH_INTERVAL_MINUTES=30
RSS_MAX_CONCURRENCY=4
# Sustained process RSS guard. Three critical samples pause RSS; six recovery samples resume it.
RSS_MEMORY_WARNING_MB=600
RSS_MEMORY_PAUSE_MB=700
RSS_MEMORY_RESUME_MB=550
UPLOAD_RATE_LIMIT=20
CANVAS_UPLOAD_MAX_MB=10
CANVAS_USER_STORAGE_MAX_MB=100
CANVAS_UPLOAD_GLOBAL_CONCURRENCY=4
CANVAS_MAX_NODES_PER_PROJECT=500
CANVAS_MAX_MESSAGES_PER_AGENT=200
CANVAS_MAX_PROJECTS_PER_USER=50
CANVAS_MAX_CONTEXT_ITEMS=30
CANVAS_MAX_CONTEXT_CHARS=60000
CANVAS_MAX_AGGREGATE_CONTEXT_CHARS=120000
CANVAS_MAX_CONTEXT_IMAGE_MB=12
CANVAS_AGENT_BATCH_STALE_MS=600000
CANVAS_PDF_MAX_PAGES=100
WRITE_AGENT_ALLOWED_MODELS="mimo-v2.5-pro"
WRITE_AGENT_MAX_OUTPUT_TOKENS=2000
AVATAR_UPLOAD_MAX_MB=5
IMAGE_PROXY_MAX_MB=8
IMAGE_PROXY_TIMEOUT_MS=8000
JSON_BODY_LIMIT_KB=256
ASR_MAX_FRAME_KB=256
ASR_MAX_PENDING_MB=2
ASR_MAX_SESSION_SECONDS=600
ASR_MAX_CONNECTIONS_PER_USER=2
ASR_MAX_GLOBAL_CONNECTIONS=20
ASR_MAX_SESSION_AUDIO_MB=25
ASR_MAX_BYTES_PER_SECOND=1048576
ASR_MAX_UPSTREAM_BUFFER_MB=1
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
ACCOUNT_EXPORT_MAX_MB=16

# Local development port. Keep this stable so browser URLs, callbacks, and agents do not drift.
PORT=1000

# Local Clash Fake-IP compatibility only. Fake-IP hostnames are independently verified through public DNS.
# Keep false in shared config and never set it on Railway.
ALLOW_DEV_PROXY_FAKE_IP=false
# Optional local Clash HTTP proxy. Only explicit 127.0.0.1/[::1] URLs are accepted; never set on Railway.
DEV_PROXY_URL=""

# RESEND_API_KEY: Required for sending verification code emails.
# Get your API key at https://resend.com
RESEND_API_KEY="your-resend-api-key"

# AI Card Extraction (OpenAI-compatible MiMo Token Plan)
AI_API_KEY="your-mimo-token-plan-api-key"
AI_BASE_URL="https://token-plan-sgp.xiaomimimo.com/v1"
AI_MODEL="mimo-v2.5-pro"

# Optional OpenAI official Writing Agent runtime override.
# If omitted, the writing Agent uses AI_API_KEY/AI_BASE_URL/AI_MODEL above.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Local or isolated integration-test account only. Never point these at production credentials.
TEST_EMAIL=""
TEST_PASSWORD=""
